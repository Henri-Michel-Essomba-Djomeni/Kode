<!-- Thème sombre de Kode : fond indigo, accent violet tiré du logo -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181723"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E1D2B"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="#E6E4F2"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#8D8AA8"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#2B2940"/>

    <SolidColorBrush x:Key="ActivityBarBackgroundBrush" Color="#12111B"/>
    <SolidColorBrush x:Key="ActivityBarForegroundBrush" Color="#7E7B99"/>
    <SolidColorBrush x:Key="ActivityBarActiveForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#26243A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B6CFF"/>

    <LinearGradientBrush x:Key="StatusBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2F6FED" Offset="0"/>
        <GradientStop Color="#7A3FF2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>
</ResourceDictionary>