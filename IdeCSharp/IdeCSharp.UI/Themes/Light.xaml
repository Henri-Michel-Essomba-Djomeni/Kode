<!-- Couleurs du thème clair : seulement ce que Kode dessine lui-même.
     Les contrôles standard (menu, barre d'état...) sont stylés par le thème Fluent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#D0D0D0"/>
</ResourceDictionary>
