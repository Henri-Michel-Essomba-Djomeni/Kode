<!-- Thème clair de Kode : mêmes rôles de couleurs que le thème sombre -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FBFBFE"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F2F1F9"/>
    <SolidColorBrush x:Key="PanelForegroundBrush" Color="#1E1B2E"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#6B6880"/>
    <SolidColorBrush x:Key="SplitterBrush" Color="#DAD8EA"/>

    <SolidColorBrush x:Key="ActivityBarBackgroundBrush" Color="#E7E5F3"/>
    <SolidColorBrush x:Key="ActivityBarForegroundBrush" Color="#6C6985"/>
    <SolidColorBrush x:Key="ActivityBarActiveForegroundBrush" Color="#1E1B2E"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#DCD9EE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B3FD6"/>

    <LinearGradientBrush x:Key="StatusBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2F6FED" Offset="0"/>
        <GradientStop Color="#7A3FF2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="SyntaxMethodBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#C2410C"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#8A879E"/>

</ResourceDictionary>