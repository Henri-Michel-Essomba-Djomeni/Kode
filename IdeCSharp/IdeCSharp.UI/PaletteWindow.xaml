<Window x:Class="IdeCSharp.UI.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Width="560" SizeToContent="Height"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PanelForegroundBrush}">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                <TextBlock x:Name="TitleText" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBox x:Name="SearchBox" FontSize="15" Padding="10,7"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
            </StackPanel>

            <ListBox x:Name="ResultList" MaxHeight="340" Margin="8,0,8,10" BorderThickness="0"
                     Background="Transparent" PreviewMouseLeftButtonUp="OnListClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12"
                                       Margin="16,0,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>