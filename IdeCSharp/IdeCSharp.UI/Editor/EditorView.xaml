<UserControl x:Class="IdeCSharp.UI.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IdeCSharp.UI.Editor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de recherche et remplacement -->
        <local:FindReplaceBar x:Name="FindBar"
                              Grid.Row="0"
                              Visibility="Collapsed"/>

        <Grid Grid.Row="1">
            <!-- Message affiché quand aucun onglet n'est ouvert -->
            <TextBlock x:Name="EmptyMessage"
                       Text="Aucun fichier ouvert"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Visibility="Visible"/>

            <!-- Conteneur d'onglets pour les documents ouverts -->
            <TabControl x:Name="TabDocuments"
                        Style="{StaticResource EditorTabControlStyle}"
                        ItemContainerStyle="{StaticResource EditorTabItemStyle}"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        Foreground="{DynamicResource PanelForegroundBrush}"
                        BorderThickness="0"
                        Visibility="Collapsed"
                        SelectionChanged="OnSelectionChanged"/>
        </Grid>
    </Grid>
</UserControl>
