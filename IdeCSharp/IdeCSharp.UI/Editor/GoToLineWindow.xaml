<Window x:Class="IdeCSharp.UI.Editor.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aller à la ligne"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PanelForegroundBrush}">
    <StackPanel Margin="20" Width="300">
        <TextBlock x:Name="PromptLabel"
                   Text="Numéro de ligne :"
                   Foreground="{DynamicResource PanelForegroundBrush}"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="LineTextBox"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource PanelForegroundBrush}"
                 BorderBrush="{DynamicResource SplitterBrush}"
                 Padding="4,2"
                 Margin="0,0,0,6"/>
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"
                    MinWidth="75"
                    Height="24"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnOkClick"/>
            <Button Content="Annuler"
                    MinWidth="75"
                    Height="24"
                    IsCancel="True"
                    Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
