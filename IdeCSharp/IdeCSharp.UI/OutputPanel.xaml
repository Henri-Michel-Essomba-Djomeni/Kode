<UserControl x:Class="IdeCSharp.UI.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zone d'affichage de la sortie du programme -->
        <TextBox x:Name="OutputBox" Grid.Row="0"
                 IsReadOnly="True"
                 FontFamily="Consolas" FontSize="13"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0" Padding="10,4"
                 Background="{DynamicResource PanelBackgroundBrush}"
                 Foreground="{DynamicResource PanelForegroundBrush}"/>

        <!-- Saisie envoyée au programme + boutons -->
        <DockPanel Grid.Row="1" Margin="10,4,10,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                <Button Content="Envoyer" Padding="10,2" Margin="0,0,6,0" Click="Send_Click"/>
                <Button Content="Copier" Padding="10,2" Margin="0,0,6,0" Click="Copy_Click"/>
                <Button Content="Effacer" Padding="10,2" Click="Clear_Click"/>
            </StackPanel>
            <TextBox x:Name="InputBox" FontFamily="Consolas" Padding="4,2"
                     KeyDown="InputBox_KeyDown"
                     Background="{DynamicResource PanelBackgroundBrush}"
                     Foreground="{DynamicResource PanelForegroundBrush}"
                     CaretBrush="{DynamicResource PanelForegroundBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>