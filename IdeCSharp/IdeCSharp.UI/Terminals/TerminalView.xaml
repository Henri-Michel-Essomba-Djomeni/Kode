<UserControl x:Class="IdeCSharp.UI.Terminal.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <!-- Barre du haut : choix de la console, redémarrer, effacer -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4">
            <TextBlock Text="Console :" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource PanelForegroundBrush}"/>
            <ComboBox x:Name="ShellCombo" Width="130" SelectedIndex="0"
                      SelectionChanged="OnShellChanged">
                <ComboBoxItem Content="cmd"/>
                <ComboBoxItem Content="PowerShell"/>
            </ComboBox>
            <Button Content="Redémarrer" Margin="8,0,0,0" Padding="10,2" Click="OnRestartClick"/>
            <Button Content="Effacer" Margin="6,0,0,0" Padding="10,2" Click="OnClearClick"/>
        </StackPanel>

        <!-- Ligne de saisie en bas -->
        <TextBox x:Name="InputBox" DockPanel.Dock="Bottom" Margin="6,0,6,6"
                 FontFamily="Consolas" FontSize="12"
                 PreviewKeyDown="OnInputKeyDown"/>

        <!-- Affichage de la sortie : le reste de la place. Aucune couleur en dur : le thème s'en charge. -->
        <TextBox x:Name="OutputBox" Margin="6,0,6,4"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
</UserControl>
