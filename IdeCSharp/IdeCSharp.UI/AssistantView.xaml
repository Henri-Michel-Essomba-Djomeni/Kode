<UserControl x:Class="IdeCSharp.UI.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- En-tête -->
        <DockPanel DockPanel.Dock="Top" Margin="14,12,10,8">
            <Button DockPanel.Dock="Right" Content="Effacer" Padding="8,2" FontSize="11"
                    Click="OnClearClick"/>
            <TextBlock Text="ASSISTANT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBlock x:Name="StateText" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </DockPanel>

        <!-- Saisie : Entrée envoie, Maj+Entrée fait un retour à la ligne -->
        <Grid DockPanel.Dock="Bottom" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                     PreviewKeyDown="OnInputKeyDown"
                     ToolTip="Entrée pour envoyer, Maj+Entrée pour un retour à la ligne"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Envoyer" Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Click="OnSendClick"/>
        </Grid>

        <!-- Conversation -->
        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="10,0,10,0">
                <ItemsControl x:Name="MessageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Bulle de l'assistant par défaut, alignée à gauche -->
                            <Border x:Name="Bubble" Margin="0,0,32,8" Padding="10,8" CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource HoverBrush}">
                                <TextBlock x:Name="BubbleText" Text="{Binding Text}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PanelForegroundBrush}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Message de l'utilisateur : à droite, en couleur d'accent -->
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="Margin" Value="32,0,0,8"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="BubbleText" Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Text="Pose une question sur ton code…"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </Grid>
    </DockPanel>
</UserControl>