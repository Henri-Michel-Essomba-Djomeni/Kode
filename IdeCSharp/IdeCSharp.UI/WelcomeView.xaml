<UserControl x:Class="IdeCSharp.UI.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IdeCSharp.UI">
    <!-- Le Viewbox réduit tout si la zone devient trop petite, sans jamais agrandir -->
    <Viewbox StretchDirection="DownOnly" Margin="24">
        <StackPanel Width="420" VerticalAlignment="Center">

            <Image Source="{StaticResource KodeIconImage}" Width="88" Height="88"/>
            <TextBlock Text="Kode" FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Foreground="{DynamicResource PanelForegroundBrush}"/>
            <TextBlock Text="Un IDE simple, fluide et intuitif"
                       HorizontalAlignment="Center" Margin="0,4,0,26"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

            <TextBlock Text="DÉMARRER" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

            <!-- Carte : ouvrir un dossier -->
            <Button Style="{StaticResource WelcomeCardStyle}"
                    Command="{x:Static local:AppCommands.OpenFolder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,14,0"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconExplorer}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="24" Stretch="None"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Ouvrir un dossier" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PanelForegroundBrush}"/>
                        <TextBlock Text="Parcourir un projet existant" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <TextBlock Text="Ctrl+Maj+O" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Carte : nouveau fichier -->
            <Button Style="{StaticResource WelcomeCardStyle}"
                    Command="ApplicationCommands.New">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,14,0"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconNewFile}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="24" Stretch="None"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Nouveau fichier" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PanelForegroundBrush}"/>
                        <TextBlock Text="Commencer un fichier vide" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <TextBlock Text="Ctrl+N" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Carte : thèmes et extensions -->
            <Button Style="{StaticResource WelcomeCardStyle}"
                    Command="{x:Static local:AppCommands.ShowExtensions}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,14,0"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconExtensions}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="24" Stretch="None"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thèmes et extensions" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PanelForegroundBrush}"/>
                        <TextBlock Text="Personnaliser les couleurs de Kode" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                            Background="{DynamicResource ActivityBarBackgroundBrush}">
                        <TextBlock Text="Ctrl+Maj+X" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Récents : rempli par le code (SetRecents), masqué s'il n'y en a pas -->
            <TextBlock x:Name="RecentsTitle" Text="RÉCENTS" FontSize="11" FontWeight="SemiBold"
                       Margin="2,14,0,8" Visibility="Collapsed"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <StackPanel x:Name="RecentsPanel"/>
        </StackPanel>
    </Viewbox>
</UserControl>