<Window x:Class="IdeCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IdeCSharp"
        Title="Kode"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <!-- Branchement des commandes : tout passe par OnCommandExecuted -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnCommandExecuted"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnCommandExecuted"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnCommandExecuted"/>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnCommandExecuted"/>
        <CommandBinding Command="ApplicationCommands.Replace" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.OpenFolder}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.SaveAs}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.GoToLine}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.Run}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.Stop}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.ToggleExplorer}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.ToggleBottomPanel}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.About}" Executed="OnCommandExecuted"/>
        <CommandBinding Command="{x:Static local:AppCommands.Exit}" Executed="OnCommandExecuted"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de menus -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Fichier">
                <MenuItem Command="ApplicationCommands.New" Header="_Nouveau fichier"/>
                <MenuItem Command="ApplicationCommands.Open" Header="_Ouvrir un fichier..."/>
                <MenuItem Command="{x:Static local:AppCommands.OpenFolder}"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Save" Header="_Enregistrer"/>
                <MenuItem Command="{x:Static local:AppCommands.SaveAs}"/>
                <Separator/>
                <MenuItem Command="{x:Static local:AppCommands.Exit}"/>
            </MenuItem>
            <MenuItem Header="_Édition">
                <MenuItem Command="ApplicationCommands.Undo" Header="_Annuler"/>
                <MenuItem Command="ApplicationCommands.Redo" Header="_Rétablir"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Cut" Header="Co_uper"/>
                <MenuItem Command="ApplicationCommands.Copy" Header="_Copier"/>
                <MenuItem Command="ApplicationCommands.Paste" Header="C_oller"/>
                <Separator/>
                <MenuItem Command="ApplicationCommands.Find" Header="_Rechercher"/>
                <MenuItem Command="ApplicationCommands.Replace" Header="Rem_placer"/>
                <MenuItem Command="{x:Static local:AppCommands.GoToLine}"/>
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Command="{x:Static local:AppCommands.ToggleExplorer}"/>
                <MenuItem Command="{x:Static local:AppCommands.ToggleBottomPanel}"/>
            </MenuItem>
            <MenuItem Header="E_xécuter">
                <MenuItem Command="{x:Static local:AppCommands.Run}"/>
                <MenuItem Command="{x:Static local:AppCommands.Stop}"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Command="{x:Static local:AppCommands.About}"/>
            </MenuItem>
        </Menu>

        <!-- Zone de travail : explorateur | éditeur + panneau du bas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="260" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Explorateur (module Fichiers) -->
            <Border x:Name="ExplorerPanel" Grid.Column="0"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="EXPLORATEUR"
                               FontSize="11" FontWeight="SemiBold" Margin="10,8,10,6"/>
                    <ContentControl x:Name="ExplorerHost">
                        <TextBlock Text="L'explorateur de fichiers s'affichera ici."
                                   Margin="10" TextWrapping="Wrap" Foreground="Gray"/>
                    </ContentControl>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1"
                          Width="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

            <!-- Éditeur + panneau du bas -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BottomPanelRow" Height="200" MinHeight="80"/>
                </Grid.RowDefinitions>

                <!-- Éditeur (module Éditeur) -->
                <ContentControl x:Name="EditorHost" Grid.Row="0">
                    <TextBlock Text="L'éditeur s'affichera ici."
                               Margin="20" Foreground="Gray"/>
                </ContentControl>

                <GridSplitter x:Name="BottomSplitter" Grid.Row="1"
                              Height="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

                <!-- Panneau du bas : sortie, terminal (modules Exécution et Terminal) -->
                <Border x:Name="BottomPanel" Grid.Row="2"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SORTIE"
                                   FontSize="11" FontWeight="SemiBold" Margin="10,6,10,4"/>
                        <ContentControl x:Name="BottomHost">
                            <TextBlock Text="La sortie des programmes s'affichera ici."
                                       Margin="10" Foreground="Gray"/>
                        </ContentControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Barre d'état -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="Prêt"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CursorText" Text="Ln 1, Col 1" Margin="0,0,16,0"/>
                    <TextBlock x:Name="LanguageText" Text="Texte brut" Margin="0,0,16,0"/>
                    <TextBlock x:Name="EncodingText" Text="UTF-8"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>