<Window x:Class="IdeCSharp.UI.CloneRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloner un dépôt GitHub" Width="580" Height="660" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PanelForegroundBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête et recherche -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Cloner un dépôt GitHub" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="AccountText" Margin="0,2,0,14"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBlock Text="Tes dépôts publics" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="OnSearchChanged"/>
        </StackPanel>

        <!-- Liste des dépôts, avec un message par-dessus quand elle est vide -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListBox x:Name="RepoList" BorderThickness="1" SelectionChanged="OnRepoSelected"
                     BorderBrush="{DynamicResource SplitterBrush}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Language}" FontSize="11"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ListMessage" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </Grid>

        <!-- URL, destination, progression et boutons -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Ou colle l'URL d'un dépôt public :" Margin="0,14,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBox x:Name="UrlBox" Padding="8,6" TextChanged="OnUrlChanged"/>

            <TextBlock Text="Dossier de destination :" Margin="0,12,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Parcourir…" Margin="8,0,0,0" Padding="12,4"
                        Click="OnBrowseClick"/>
                <TextBox x:Name="DestBox" Padding="8,6"/>
            </DockPanel>

            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,14,0,0"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="18"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Fermer" Padding="16,6" Margin="0,0,8,0"
                        Click="OnCancelClick"/>
                <Button x:Name="CloneButton" Content="Cloner" Style="{StaticResource AccentButtonStyle}"
                        Click="OnCloneClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>